# ── Core ──────────────────────────────────────────────────────────────────────
# Public base URL (used for Stripe/Google redirects, iCal links, embed snippet).
APP_URL=http://localhost:3000
# Random 32+ byte secret for signing OAuth state.  openssl rand -base64 32
APP_SECRET=

# ── Database & auth (Supabase) ────────────────────────────────────────────────
# Leave unset for local dev: a JSON file store under .data/ is used, seeded with
# a "demo" tenant, and the owner dashboard is open without login.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── AI vision ─────────────────────────────────────────────────────────────────
# Unset → photo analysis returns labelled demo output.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# ── Payments (Stripe Connect) ─────────────────────────────────────────────────
# Unset → bookings confirm without a deposit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Connect endpoint secret, for account.updated from connected accounts.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Platform fee on each deposit, in basis points (300 = 3%).
PLATFORM_FEE_BPS=300

# ── Google Calendar (optional) ────────────────────────────────────────────────
# OAuth "Web application" client; redirect URI: $APP_URL/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
